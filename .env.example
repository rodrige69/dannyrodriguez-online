# Phase 3 (Sanity) — required for Field Notes, Right Now, and The Lab to load real content.
# Project ID and org are Danny's actual Sanity project; safe to commit (not secrets).
NEXT_PUBLIC_SANITY_PROJECT_ID=bkxauu92
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# No API token is required for the site to read published content — the dataset is public and
# every query already filters to status == "published" (see sanity/lib/queries.ts). Only add
# SANITY_API_READ_TOKEN (server-only — never NEXT_PUBLIC_*) later if the dataset gets switched
# to private, or the site needs to preview drafts.
# SANITY_API_READ_TOKEN=

# Never commit a real .env.local (or any file with real secret values) — .gitignore already
# excludes .env* by default. Project ID/dataset above are not secrets, which is why they're
# filled in directly here rather than left blank.
